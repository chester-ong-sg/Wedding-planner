# Vercel (and CI) run a strict `npm install`, which refuses these known peer
# conflicts even though the app works with them:
#   - react-day-picker@8 declares a peer of date-fns ^2 || ^3; the project uses date-fns 4
#   - react-konva / konva peer ranges on React 19
# Without this, the install step fails with ERESOLVE and the deploy never builds.
# The proper fix is upgrading react-day-picker to v9 (which supports date-fns 4),
# after which this file can be deleted.
legacy-peer-deps=true
